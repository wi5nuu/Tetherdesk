# TetherDesk environment variables
# Copy this file to .env.local and fill in your values

# JWT signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
JWT_SIGNING_SECRET=

# Upstash Redis REST API credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Agent secret — shared secret between agent and backend for authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_SECRET=

# Key namespace for Redis (use "dev" for local development, "prod" for production)
TETHERDESK_KEY_NAMESPACE=dev

# Backend origin (used by the PWA)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
