# TetherDesk environment variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is in .gitignore.
# These variables are set automatically by `npx tetherdesk init`.

# -----------------------------------------------------------------------------
# Required — generated by the installer and stored in Vercel environment vars
# -----------------------------------------------------------------------------

# 256-bit secret used to sign session bearer JWTs (HS256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SIGNING_SECRET=

# Upstash Redis REST endpoint — injected automatically by the Vercel Marketplace integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Redis key namespace prefix. Defaults to "td". Set to "preview" on preview
# deployments to avoid cross-contaminating the production mailbox namespace.
# TETHERDESK_KEY_NAMESPACE=td

# TURN relay credentials (opt-in, see docs/runbooks/nat-traversal.md).
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Public origin of this deployment (e.g. https://tetherdesk-xyz.vercel.app).
# Required only if you use a custom domain; otherwise Vercel sets it automatically.
# NEXT_PUBLIC_APP_ORIGIN=
